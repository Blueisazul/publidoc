---
import { getCollection, render } from 'astro:content';
import '../../../styles/global.css';

export const prerender = true;

export async function getStaticPaths() {
  const docs = await getCollection('docs');
  return docs.map((doc) => ({
    params: { id: doc.id },
    props: { doc },
  }));
}

const { doc } = Astro.props;
const { Content } = await render(doc);

const categories = await getCollection('categories');
const categoryObj = categories.find((c) => c.id === doc.data.category);
const categoryName = categoryObj ? categoryObj.data.name : (doc.data.category || 'General');

const baseUrl = import.meta.env.BASE_URL.endsWith('/') 
  ? import.meta.env.BASE_URL 
  : `${import.meta.env.BASE_URL}/`;

const siteUrl = Astro.site ? Astro.site.toString().replace(/\/$/, '') : '';
const relativeDocPath = `${baseUrl}d/${doc.id}/`;
const relativeRawPath = `${baseUrl}d/${doc.id}/raw.md`;

const publicPageUrl = `${siteUrl}${relativeDocPath}`;
const rawMarkdownUrl = `${siteUrl}${relativeRawPath}`;

const formattedCreatedAt = new Intl.DateTimeFormat('es-ES', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
}).format(doc.data.createdAt);

const formattedUpdatedAt = new Intl.DateTimeFormat('es-ES', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
}).format(doc.data.updatedAt);
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href={`${baseUrl}favicon.svg`} />
    
    <!-- Metadatos SEO y Open Graph -->
    <title>{doc.data.title} — Public Document Hub</title>
    {doc.data.description && <meta name="description" content={doc.data.description} />}
    <link rel="canonical" href={publicPageUrl} />
    <meta property="og:title" content={doc.data.title} />
    {doc.data.description && <meta property="og:description" content={doc.data.description} />}
    <meta property="og:type" content="article" />
    <meta property="og:url" content={publicPageUrl} />

    <!-- Enlace directo al archivo Markdown original para clientes IA -->
    <link rel="alternate" type="text/markdown" href={rawMarkdownUrl} title="Markdown Original" />
  </head>
  <body>
    <header>
      <a href={baseUrl} class="site-title">
        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
          <polyline points="14 2 14 8 20 8"></polyline>
          <line x1="16" y1="13" x2="8" y2="13"></line>
          <line x1="16" y1="17" x2="8" y2="17"></line>
        </svg>
        Public Document Hub
      </a>
      <a href={baseUrl} class="btn btn-outline" style="font-size: 0.8rem; padding: 0.3rem 0.7rem;">
        ← Volver a la biblioteca
      </a>
    </header>

    <main>
      <article>
        <h1>{doc.data.title}</h1>
        {doc.data.description && (
          <p style="font-size: 1.15rem; color: var(--text-muted); margin-bottom: 1.25rem;">
            {doc.data.description}
          </p>
        )}

        <div class="meta-bar">
          <span>📁 Categoría: <strong>{categoryName}</strong></span>
          <span>📅 Creado: <time datetime={doc.data.createdAt.toISOString()}>{formattedCreatedAt}</time></span>
          <span>🔄 Actualizado: <time datetime={doc.data.updatedAt.toISOString()}>{formattedUpdatedAt}</time></span>
          <span>🔑 ID: <code>{doc.id}</code></span>
        </div>

        {doc.data.tags && doc.data.tags.length > 0 && (
          <div class="tag-list" style="margin-bottom: 1.5rem;">
            {doc.data.tags.map((tag: string) => (
              <span class="tag">#{tag}</span>
            ))}
          </div>
        )}

        <!-- Acciones de copiado y acceso a Markdown -->
        <div class="card" style="margin-bottom: 2rem; background: var(--code-bg);">
          <h3 style="margin-top: 0; font-size: 1rem; margin-bottom: 0.5rem;">Enlaces del documento</h3>
          <p style="font-size: 0.875rem; color: var(--text-muted); margin-bottom: 0.75rem;">
            Usa el enlace Markdown para consultar o alimentar agentes de IA (como ChatGPT) con el documento íntegro.
          </p>
          <div class="action-group" style="margin: 0;">
            <a href={relativeRawPath} target="_blank" rel="noopener noreferrer" class="btn btn-primary" id="raw-link" data-raw-url={rawMarkdownUrl}>
              📄 Ver Markdown original
            </a>
            <button type="button" class="btn btn-outline" id="btn-copy-url" data-url={publicPageUrl} data-relative={relativeDocPath}>
              🔗 Copiar enlace público
            </button>
            <button type="button" class="btn btn-outline" id="btn-copy-raw" data-url={rawMarkdownUrl} data-relative={relativeRawPath}>
              📋 Copiar enlace Markdown
            </button>
          </div>
          <p id="copy-status" style="font-size: 0.8rem; color: var(--primary); margin-top: 0.5rem; margin-bottom: 0; display: none;">
            ¡Enlace copiado al portapapeles!
          </p>
        </div>

        <!-- Contenido renderizado del Markdown -->
        <div class="markdown-body">
          <Content />
        </div>
      </article>
    </main>

    <footer>
      <p>Public Document Hub — Documentación abierta y accesible para humanos e Inteligencia Artificial.</p>
    </footer>

    <script>
      function setupCopyButtons() {
        // Resolver imágenes de /uploads/ bajo BASE_PATH en entornos como GitHub Pages
        const currentBase = document.querySelector('link[rel="icon"]')?.getAttribute('href')?.replace(/favicon\.svg$/, '') || '';
        const cleanBase = currentBase.replace(/\/$/, '');
        if (cleanBase) {
          document.querySelectorAll('.markdown-body img').forEach((img) => {
            const src = img.getAttribute('src');
            if (src && src.startsWith('/uploads/')) {
              img.setAttribute('src', `${cleanBase}${src}`);
            }
          });
        }

        const copyStatus = document.getElementById('copy-status');
        const showCopiedMessage = () => {
          if (!copyStatus) return;
          copyStatus.style.display = 'block';
          setTimeout(() => {
            copyStatus.style.display = 'none';
          }, 2500);
        };

        const copyPublicBtn = document.getElementById('btn-copy-url');
        if (copyPublicBtn) {
          copyPublicBtn.addEventListener('click', async () => {
            let url = copyPublicBtn.getAttribute('data-url') || '';
            if (typeof window !== 'undefined' && window.location) {
              const rel = copyPublicBtn.getAttribute('data-relative') || '';
              url = rel ? new URL(rel, window.location.origin).href : window.location.href;
            }
            if (url) {
              await navigator.clipboard.writeText(url);
              showCopiedMessage();
            }
          });
        }

        const copyRawBtn = document.getElementById('btn-copy-raw');
        if (copyRawBtn) {
          copyRawBtn.addEventListener('click', async () => {
            let rawUrl = copyRawBtn.getAttribute('data-url') || '';
            if (typeof window !== 'undefined' && window.location) {
              const rel = copyRawBtn.getAttribute('data-relative') || '';
              rawUrl = rel ? new URL(rel, window.location.origin).href : rawUrl;
            }
            if (rawUrl) {
              await navigator.clipboard.writeText(rawUrl);
              showCopiedMessage();
            }
          });
        }
      }

      setupCopyButtons();
    </script>
  </body>
</html>
