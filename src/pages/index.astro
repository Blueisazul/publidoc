---
import { getCollection } from 'astro:content';
import '../styles/global.css';

export const prerender = true;

const docs = await getCollection('docs');

// Ordenar por fecha de actualización descendente
const sortedDocs = docs.sort(
  (a, b) => b.data.updatedAt.getTime() - a.data.updatedAt.getTime()
);

const baseUrl = import.meta.env.BASE_URL.endsWith('/') 
  ? import.meta.env.BASE_URL 
  : `${import.meta.env.BASE_URL}/`;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href={`${baseUrl}favicon.svg`} />
    <title>Biblioteca Pública — Public Document Hub</title>
    <meta name="description" content="Centro de documentación pública accesible para personas y agentes de Inteligencia Artificial." />
  </head>
  <body>
    <header>
      <a href={baseUrl} class="site-title">
        <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
          <polyline points="14 2 14 8 20 8"></polyline>
          <line x1="16" y1="13" x2="8" y2="13"></line>
          <line x1="16" y1="17" x2="8" y2="17"></line>
        </svg>
        Public Document Hub
      </a>
      <span style="font-size: 0.875rem; color: var(--text-muted);">
        {docs.length} documento{docs.length === 1 ? '' : 's'} disponible{docs.length === 1 ? '' : 's'}
      </span>
    </header>

    <main>
      <section style="margin-bottom: 2rem;">
        <h1>Biblioteca de Documentos</h1>
        <p style="color: var(--text-muted); font-size: 1.1rem;">
          Explora la colección de documentos técnicos y funcionales publicados. Cada documento cuenta con una URL pública permanente y acceso al contenido Markdown íntegro para agentes como ChatGPT.
        </p>
      </section>

      <section>
        {sortedDocs.length === 0 ? (
          <div class="card" style="text-align: center; padding: 3rem 1rem;">
            <p style="color: var(--text-muted); font-size: 1.1rem; margin-bottom: 0;">
              No hay documentos publicados en este momento.
            </p>
          </div>
        ) : (
          <div>
            {sortedDocs.map((doc) => {
              const docUrl = `${baseUrl}d/${doc.id}/`;
              const rawUrl = `${baseUrl}d/${doc.id}/raw.md`;
              const formattedDate = new Intl.DateTimeFormat('es-ES', {
                year: 'numeric',
                month: 'short',
                day: 'numeric',
              }).format(doc.data.updatedAt);

              return (
                <article class="card">
                  <div style="display: flex; justify-content: space-between; align-items: baseline; flex-wrap: wrap; gap: 0.5rem;">
                    <h2 style="margin: 0; font-size: 1.35rem; border: none; padding: 0;">
                      <a href={docUrl} style="color: var(--text-main); text-decoration: none;">
                        {doc.data.title}
                      </a>
                    </h2>
                    <span style="font-size: 0.8rem; color: var(--text-muted);">
                      Actualizado: {formattedDate}
                    </span>
                  </div>

                  {doc.data.description && (
                    <p style="color: var(--text-muted); margin: 0.75rem 0 0.5rem 0; font-size: 0.95rem;">
                      {doc.data.description}
                    </p>
                  )}

                  {doc.data.tags && doc.data.tags.length > 0 && (
                    <div class="tag-list" style="margin: 0.5rem 0 1rem 0;">
                      {doc.data.tags.map((tag: string) => (
                        <span class="tag">#{tag}</span>
                      ))}
                    </div>
                  )}

                  <div class="action-group" style="margin-top: 1rem; margin-bottom: 0;">
                    <a href={docUrl} class="btn btn-primary" style="font-size: 0.8rem; padding: 0.4rem 0.8rem;">
                      Leer documento →
                    </a>
                    <a href={rawUrl} target="_blank" rel="noopener noreferrer" class="btn btn-outline" style="font-size: 0.8rem; padding: 0.4rem 0.8rem;">
                      Ver Markdown (raw)
                    </a>
                  </div>
                </article>
              );
            })}
          </div>
        )}
      </section>
    </main>

    <footer>
      <p>Public Document Hub — Documentación estática impulsada por Astro y GitHub.</p>
    </footer>
  </body>
</html>
